---
import resume from "../data/resume.json";

const companies = resume.companies;
const skillCategories = resume.skillCategories;
const projects = resume.projects;
const links = resume.links;
---

<style is:global>
	:root {
		--bg: #0b0f14;
		--term-bg: #10161d;
		--term-border: #263140;
		--titlebar: #1a222d;
		--text: #c9d4e0;
		--dim: #6d7d8f;
		--accent: #56d66b;
		--link: #58a6ff;
		--row-hover: #1a2330;
		--row-active: #203044;
		--tag-bg: #1a2330;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		background: var(--bg);
		background-image: radial-gradient(ellipse 80% 50% at 50% -10%, #16202c 0%, var(--bg) 70%);
		color: var(--text);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
		font-size: 15px;
		line-height: 1.55;
		min-height: 100vh;
	}

	a {
		color: var(--link);
		text-decoration: none;
	}

	a:hover,
	a:focus-visible {
		text-decoration: underline;
	}

	.wrap {
		max-width: 980px;
		margin: 0 auto;
		padding: 3rem 1rem 4rem;
	}

	.terminal {
		background: var(--term-bg);
		border: 1px solid var(--term-border);
		border-radius: 10px;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
		overflow: hidden;
	}

	.titlebar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--titlebar);
		padding: 0.55rem 1rem;
		border-bottom: 1px solid var(--term-border);
	}

	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
	}

	.dot.r { background: #ff5f56; }
	.dot.y { background: #ffbd2e; }
	.dot.g { background: #27c93f; }

	.titlebar-title {
		flex: 1;
		text-align: center;
		color: var(--dim);
		font-size: 0.85rem;
	}

	.term-body {
		padding: 1.5rem 1.75rem 1.25rem;
	}

	.prompt {
		color: var(--accent);
	}

	.dim {
		color: var(--dim);
	}

	/* boot sequence */
	.boot {
		margin-bottom: 1.25rem;
		white-space: pre-wrap;
	}

	.boot .cmd-line .prompt::after {
		content: "$";
		margin-right: 0.55em;
	}

	.cursor {
		display: inline-block;
		width: 0.6em;
		height: 1.15em;
		background: var(--accent);
		vertical-align: text-bottom;
		animation: blink 1.06s steps(1) infinite;
	}

	@keyframes blink {
		50% { opacity: 0; }
	}

	/* views */
	[data-view] {
		display: none;
	}

	[data-view].active {
		display: block;
		animation: fadein 140ms ease-out;
	}

	@keyframes fadein {
		from { opacity: 0; transform: translateY(3px); }
		to { opacity: 1; transform: none; }
	}

	/* menu */
	.menu {
		margin-top: 0.5rem;
	}

	.menu-item {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		width: 100%;
		background: none;
		border: 0;
		border-radius: 6px;
		color: var(--text);
		font: inherit;
		padding: 0.45rem 0.75rem;
		margin: 0.15rem 0;
		cursor: pointer;
		text-align: left;
	}

	.menu-item .idx {
		color: var(--dim);
		width: 1.2ch;
	}

	.menu-item .fname {
		color: var(--link);
		min-width: 13ch;
		display: inline-block;
	}

	.menu-item .desc {
		color: var(--dim);
	}

	.menu-item .arrow {
		position: absolute;
		left: -0.9rem;
		color: var(--accent);
		opacity: 0;
	}

	.menu-item {
		position: relative;
	}

	.menu-item:hover,
	.menu-item:focus-visible,
	.menu-item.cursored {
		background: var(--row-active);
		text-decoration: none;
	}

	.menu-item:hover .arrow,
	.menu-item:focus-visible .arrow,
	.menu-item.cursored .arrow {
		opacity: 1;
	}

	/* section file views */
	.file-header {
		margin-bottom: 1.25rem;
	}

	.file-header .prompt::after {
		content: "$";
		margin-right: 0.55em;
	}

	.back {
		background: none;
		border: 1px solid var(--term-border);
		border-radius: 6px;
		color: var(--dim);
		font: inherit;
		font-size: 0.85rem;
		padding: 0.25rem 0.75rem;
		cursor: pointer;
		margin-bottom: 1rem;
	}

	.back:hover,
	.back:focus-visible {
		color: var(--text);
		border-color: var(--dim);
		text-decoration: none;
	}

	.section-title {
		font-size: 1.6rem;
		font-weight: 700;
		margin: 0 0 0.35rem;
	}

	.section-sub {
		color: var(--dim);
		margin: 0 0 1.5rem;
	}

	/* experience */
	.entry {
		border: 1px solid var(--term-border);
		border-radius: 8px;
		padding: 1rem 1.25rem;
		margin-bottom: 1rem;
	}

	.entry-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-bottom: 0.5rem;
	}

	.entry-name {
		font-weight: 700;
		font-size: 1.05rem;
	}

	.entry-name .sep {
		color: var(--dim);
		font-weight: 400;
	}

	.entry-dates {
		color: var(--dim);
		font-size: 0.85rem;
	}

	.entry ul {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
	}

	.entry li {
		margin-bottom: 0.4rem;
	}

	.entry li::marker {
		color: var(--accent);
	}

	/* skills */
	.skill-group {
		margin-bottom: 1.5rem;
	}

	.skill-group h3 {
		margin: 0 0 0.6rem;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--dim);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.tag {
		background: var(--tag-bg);
		border: 1px solid var(--term-border);
		border-radius: 999px;
		padding: 0.15rem 0.8rem;
		font-size: 0.9rem;
	}

	/* projects */
	.project {
		border: 1px solid var(--term-border);
		border-radius: 8px;
		padding: 1rem 1.25rem;
		margin-bottom: 1rem;
	}

	.project-name {
		font-weight: 700;
	}

	.project-name a {
		color: var(--text);
	}

	.project-desc {
		color: var(--dim);
		margin: 0.1rem 0 0.5rem;
	}

	.project ul {
		margin: 0 0 0.5rem;
		padding-left: 1.1rem;
	}

	.project li::marker {
		color: var(--accent);
	}

	.project .gh {
		font-size: 0.85rem;
		color: var(--dim);
	}

	/* about / contact */
	.about-p {
		max-width: 60ch;
		margin-bottom: 1.25rem;
	}

	.contact-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.contact-list li {
		display: flex;
		gap: 1rem;
		padding: 0.4rem 0;
		border-bottom: 1px dashed var(--term-border);
	}

	.contact-list li:last-child {
		border-bottom: 0;
	}

	.contact-list .k {
		color: var(--dim);
		min-width: 9ch;
	}

	/* status bar */
	.statusbar {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		border-top: 1px solid var(--term-border);
		padding: 0.4rem 1rem;
		font-size: 0.8rem;
		color: var(--dim);
		background: var(--titlebar);
	}

	.statusbar .hint kbd {
		background: var(--tag-bg);
		border: 1px solid var(--term-border);
		border-radius: 4px;
		padding: 0 0.35em;
		font-family: inherit;
		font-size: 0.75rem;
	}

	@media (max-width: 600px) {
		.wrap {
			padding: 1rem 0.5rem 2rem;
		}

		.term-body {
			padding: 1.1rem 1rem 1rem;
		}

		.statusbar .hint {
			display: none;
		}

		.menu-item .desc {
			display: none;
		}

		.menu-item .fname {
			min-width: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}

		[data-view].active {
			animation: none;
		}
	}
</style>

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Mitchell Caisse — software engineer. Experience, projects, skills, and contact." />
		<title>Mitchell Caisse</title>
	</head>
	<body>
		<div class="wrap">
			<div class="terminal" role="application" aria-label="Terminal">
				<div class="titlebar">
					<span class="dot r"></span>
					<span class="dot y"></span>
					<span class="dot g"></span>
					<span class="titlebar-title">mitchell@mwcaisse: ~</span>
				</div>

				<div class="term-body">
					<div class="boot" id="boot" aria-hidden="true"></div>

					<!-- menu -->
					<nav class="menu" data-view="menu" aria-label="Sections">
						<button class="menu-item" data-goto="about">
							<span class="arrow">➜</span>
							<span class="idx">1</span>
							<span class="fname">about.md</span>
							<span class="desc">— who i am</span>
						</button>
						<button class="menu-item" data-goto="experience">
							<span class="arrow">➜</span>
							<span class="idx">2</span>
							<span class="fname">experience.log</span>
							<span class="desc">— where i've worked</span>
						</button>
						<button class="menu-item" data-goto="skills">
							<span class="arrow">➜</span>
							<span class="idx">3</span>
							<span class="fname">skills.yaml</span>
							<span class="desc">— what i work with</span>
						</button>
						<button class="menu-item" data-goto="projects">
							<span class="arrow">➜</span>
							<span class="idx">4</span>
							<span class="fname">projects/</span>
							<span class="desc">— things i've built</span>
						</button>
						<button class="menu-item" data-goto="contact">
							<span class="arrow">➜</span>
							<span class="idx">5</span>
							<span class="fname">contact.sh</span>
							<span class="desc">— reach me</span>
						</button>
					</nav>

					<!-- about -->
					<section data-view="about">
						<div class="file-header"><span class="prompt">cat about.md</span></div>
						<button class="back" data-back>← cd ~</button>
						<h1 class="section-title">{resume.name}</h1>
						<p class="section-sub">{resume.title} · {resume.tagline}</p>
						<p class="about-p">{resume.about}</p>
						<p class="dim">education: {resume.education[0].title}, {resume.education[0].name} ({resume.education[0].dates[0].start})</p>
						<ul class="contact-list">
							<li><span class="k">blog</span><a href={links.blog} target="_blank" rel="noopener">codeuntamed.com</a></li>
							<li><span class="k">github</span><a href={links.github} target="_blank" rel="noopener">github.com/mwcaisse</a></li>
							<li><span class="k">resume</span><a href={links.resume} target="_blank">resume.pdf</a></li>
							<li><span class="k">pgp</span><a href={links.pgp} download>mwcaisse.gpg</a></li>
						</ul>
					</section>

					<!-- experience -->
					<section data-view="experience">
						<div class="file-header"><span class="prompt">cat experience.log</span></div>
						<button class="back" data-back>← cd ~</button>
						<h1 class="section-title">Experience</h1>
						<p class="section-sub">{companies.length} positions, 2015 → present</p>
						{
							companies.map((c) => (
								<div class="entry">
									<div class="entry-head">
										<span class="entry-name">
											{c.name} <span class="sep">— {c.title}</span>
										</span>
										<span class="entry-dates">
											{c.dates.map((d) => `${d.start} – ${d.end}`).join(", ")}
										</span>
									</div>
									<ul>
										{c.points.map((p) => <li>{p}</li>)}
									</ul>
								</div>
							))
						}
					</section>

					<!-- skills -->
					<section data-view="skills">
						<div class="file-header"><span class="prompt">cat skills.yaml</span></div>
						<button class="back" data-back>← cd ~</button>
						<h1 class="section-title">Skills</h1>
						<p class="section-sub">things i reach for</p>
						{
							skillCategories.map((cat) => (
								<div class="skill-group">
									<h3>{cat.name}</h3>
									<div class="tags">
										{cat.skills.map((s) => <span class="tag">{s.title}</span>)}
									</div>
								</div>
							))
						}
					</section>

					<!-- projects -->
					<section data-view="projects">
						<div class="file-header"><span class="prompt">ls -la projects/</span></div>
						<button class="back" data-back>← cd ~</button>
						<h1 class="section-title">Projects</h1>
						<p class="section-sub">side projects & experiments</p>
						{
							projects.map((p) => (
								<div class="project">
									<div class="project-name">{p.name}</div>
									<p class="project-desc">{p.description}</p>
									<ul>
										{p.details.map((d) => <li>{d}</li>)}
									</ul>
									<div class="gh">
										{p.github.map((g) => (
											<a href={g} target="_blank" rel="noopener">{new URL(g).pathname.slice(1)}</a>
										)).join(" · ")}
									</div>
								</div>
							))
						}
					</section>

					<!-- contact -->
					<section data-view="contact">
						<div class="file-header"><span class="prompt">./contact.sh --info</span></div>
						<button class="back" data-back>← cd ~</button>
						<h1 class="section-title">Contact</h1>
						<p class="section-sub">the fastest way to reach me</p>
						<ul class="contact-list">
							<li><span class="k">email</span><a href={`mailto:${links.email}`}>{links.email}</a></li>
							<li><span class="k">github</span><a href={links.github} target="_blank" rel="noopener">github.com/mwcaisse</a></li>
							<li><span class="k">blog</span><a href={links.blog} target="_blank" rel="noopener">codeuntamed.com</a></li>
							<li><span class="k">pgp</span><a href={links.pgp} download>mwcaisse.gpg</a></li>
							<li><span class="k">resume</span><a href={links.resume} target="_blank">resume.pdf</a></li>
						</ul>
					</section>
				</div>

				<div class="statusbar">
					<span>mwcaisse.com</span>
					<span class="hint">
						<kbd>↑</kbd><kbd>↓</kbd> navigate · <kbd>1-5</kbd> open · <kbd>esc</kbd> back
					</span>
					<span id="cwd">~</span>
				</div>
			</div>
		</div>

		<noscript>
			<style>
				.boot, .menu, .statusbar .hint, #cwd, .back, .file-header {
					display: none !important;
				}

				[data-view] {
					display: block !important;
					margin-bottom: 2rem;
				}
			</style>
		</noscript>
	</body>
</html>

<script>
	const views = Array.from(document.querySelectorAll("[data-view]"));
	const menuItems = Array.from(document.querySelectorAll(".menu-item"));
	const bootEl = document.getElementById("boot");
	const cwdEl = document.getElementById("cwd");
	const backButtons = Array.from(document.querySelectorAll("[data-back]"));
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const NAMES = {
		menu: "~",
		about: "~/about.md",
		experience: "~/experience.log",
		skills: "~/skills.yaml",
		projects: "~/projects/",
		contact: "~/contact.sh",
	};

	let current = "menu";
	let cursor = 0;

	function show(name) {
		current = name;
		views.forEach((v) => v.classList.toggle("active", v.dataset.view === name));
		cwdEl.textContent = NAMES[name] ?? "~";
		if (name === "menu") {
			setCursor(0);
		} else {
			menuItems.forEach((m) => m.classList.remove("cursored"));
		}
		window.scrollTo({ top: 0 });
	}

	function setCursor(i) {
		cursor = (i + menuItems.length) % menuItems.length;
		menuItems.forEach((m, idx) => m.classList.toggle("cursored", idx === cursor));
	}

	function open(name) {
		show(name);
	}

	// menu clicks
	menuItems.forEach((item) => {
		item.addEventListener("click", () => open(item.dataset.goto));
		item.addEventListener("mouseenter", () => {
			if (current === "menu") setCursor(menuItems.indexOf(item));
		});
	});

	// back buttons
	backButtons.forEach((b) => b.addEventListener("click", () => show("menu")));

	// keyboard
	document.addEventListener("keydown", (e) => {
		if (!bootDone) finishBoot();
		if (current === "menu") {
			if (e.key === "ArrowDown") {
				e.preventDefault();
				setCursor(cursor + 1);
			} else if (e.key === "ArrowUp") {
				e.preventDefault();
				setCursor(cursor - 1);
			} else if (e.key === "Enter" && document.activeElement?.classList.contains("menu-item")) {
				e.preventDefault();
				open(document.activeElement.dataset.goto);
			} else if (/^[1-5]$/.test(e.key)) {
				e.preventDefault();
				open(menuItems[Number(e.key) - 1].dataset.goto);
			}
		} else if (e.key === "Escape") {
			e.preventDefault();
			show("menu");
		}
	});

	// boot typing effect
	const bootLines = [
		{ cmd: true, text: "whoami" },
		{ cmd: false, text: "mitchell caisse — software engineer" },
		{ cmd: true, text: "ls" },
		{ cmd: false, text: "about.md  experience.log  skills.yaml  projects/  contact.sh" },
	];

	let bootDone = false;
	let bootTimers = [];

	function finishBoot() {
		bootTimers.forEach(clearTimeout);
		bootTimers = [];
		bootDone = true;
		bootEl.innerHTML = bootLines
			.map((l) =>
				l.cmd
					? `<div class="cmd-line"><span class="prompt"></span>${l.text}</div>`
					: `<div class="out">${l.text}</div>`
			)
			.join("") + `<div class="cmd-line"><span class="prompt"></span><span class="cursor"></span></div>`;
	}

	function typeBoot() {
		bootEl.innerHTML = "";
		const cursor = document.createElement("span");
		cursor.className = "cursor";
		bootEl.appendChild(cursor);

		let li = 0;
		let ci = 0;
		let el = null;

		function step() {
			if (li >= bootLines.length) {
				finishBoot();
				return;
			}
			const line = bootLines[li];
			if (ci === 0) {
				el = document.createElement("div");
				el.className = line.cmd ? "cmd-line" : "out";
				if (line.cmd) {
					const p = document.createElement("span");
					p.className = "prompt";
					el.appendChild(p);
				}
				const t = document.createElement("span");
				t.className = "typed";
				el.appendChild(t);
				bootEl.insertBefore(el, cursor);
			}
			ci += 1;
			el.querySelector(".typed").textContent = line.text.slice(0, ci);
			if (ci >= line.text.length) {
				li += 1;
				ci = 0;
				bootTimers.push(setTimeout(step, line.cmd ? 220 : 120));
			} else {
				bootTimers.push(setTimeout(step, 14));
			}
		}

		step();
	}

	if (reducedMotion) {
		finishBoot();
	} else {
		typeBoot();
	}

	document.addEventListener("click", () => {
		if (!bootDone) finishBoot();
	});

	show("menu");
</script>
